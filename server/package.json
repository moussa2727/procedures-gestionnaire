    "kill-port": "node -e \"require('child_process').exec(`netstat -ano | findstr :10000 | findstr LISTENING`, (err, stdout) => { if(stdout) { const pid = stdout.trim().split(/\\s+/).pop(); require('child_process').exec(`taskkill /PID ${pid} /F`); } })\"",
