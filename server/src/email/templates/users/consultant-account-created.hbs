<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Compte consultant créé</title>
  <style>
    :root { color-scheme: light; }
    @media (prefers-color-scheme: dark) { body { background: #f0f4f8 !important; } }
    body { margin:0; padding:0; background-color:#f0f4f8; font-family: Arial, Helvetica, sans-serif; }
    .container { max-width:560px; margin:0 auto; padding:40px 16px; }
    .card { background:#ffffff; border-radius:12px; border:1px solid #e2e8f0; overflow:hidden; }
    .header { background:#e8f0fe; padding:24px 32px; border-bottom:1px solid #d5e2f5; }
    .header h1 { margin:0; color:#1a3a5c; font-size:18px; font-weight:700; letter-spacing:0.3px; }
    .header span { display:block; color:#4a7a9c; font-size:13px; font-weight:400; margin-top:2px; }
    .body { padding:32px; }
    .body p { margin:0 0 16px; line-height:1.6; color:#2c4058; font-size:15px; }
    .body .greeting { font-weight:600; margin:0 0 6px; }
    .body .info-table { background:#f8fafc; border-radius:8px; border:1px solid #eef2f6; padding:16px; margin:0 0 20px; width:100%; }
    .body .info-table td { padding:3px 0; font-size:13px; color:#1a3a5c; }
    .body .info-table .key { color:#4a7a9c; width:80px; vertical-align:top; }
    .body .info-table .value { font-weight:500; }
    .body .btn-wrapper { text-align:center; margin:0 0 16px; }
    .body .btn { display:inline-block; background:#e8f0fe; color:#1a3a5c; font-weight:600; text-decoration:none; padding:10px 24px; border-radius:8px; font-size:14px; }
    .body .note { font-size:13px; color:#6a8ba5; line-height:1.6; margin:0; }
    .footer { padding:16px 32px; background:#f8fafc; border-top:1px solid #eef2f6; text-align:center; font-size:11px; color:#9ab0c8; line-height:1.5; }
    .footer .copy { margin:6px 0 0; color:#b5c8da; }
    @media (max-width:600px) {
      .header, .body, .footer { padding-left:20px; padding-right:20px; }
      .btn { display:block; text-align:center; }
    }
  </style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8; padding:40px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#ffffff; border-radius:12px; border:1px solid #e2e8f0; overflow:hidden;">
          <tr>
            <td style="background:#e8f0fe; padding:24px 32px; border-bottom:1px solid #d5e2f5;">
              <span style="color:#1a3a5c; font-size:18px; font-weight:700; letter-spacing:0.3px;">Paname Consulting</span>
              <span style="display:block; color:#4a7a9c; font-size:13px; font-weight:400; margin-top:2px;">Compte consultant</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="font-size:15px; font-weight:600; color:#1a3a5c; margin:0 0 6px;">
                Bonjour{{#if firstName}} {{firstName}} {{lastName}}{{/if}},
              </p>
              <p style="font-size:14px; color:#2c4058; margin:0 0 20px; line-height:1.6;">
                Un compte consultant a été créé pour vous sur la plateforme Paname Consulting.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc; border-radius:8px; border:1px solid #eef2f6; padding:16px; margin:0 0 20px;">
                {{#if email}}
                  <tr><td style="padding:3px 0; font-size:13px; color:#4a7a9c; width:80px; vertical-align:top;">Email</td><td style="padding:3px 0; font-size:13px; color:#1a3a5c; font-weight:500;">{{email}}</td></tr>
                {{/if}}
                <tr><td style="padding:3px 0; font-size:13px; color:#4a7a9c; width:80px; vertical-align:top;">Rôle</td><td style="padding:3px 0; font-size:13px; color:#1a3a5c; font-weight:500;">Consultant</td></tr>
              </table>

              <p style="font-size:13px; color:#6a8ba5; line-height:1.6; margin:0 0 4px;">
                Vous pouvez dès à présent vous connecter à votre espace consultant.
              </p>
              <p style="font-size:13px; color:#6a8ba5; line-height:1.6; margin:0 0 20px;">
                Nous vous invitons à prendre connaissance des fonctionnalités mises à votre disposition.
              </p>

              {{#if FRONTEND_URL}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="text-align:center; margin:0 0 16px;">
                  <tr>
                    <td align="center">
                      <a href="{{FRONTEND_URL}}" style="display:inline-block; background:#e8f0fe; color:#1a3a5c; font-weight:600; text-decoration:none; padding:10px 24px; border-radius:8px; font-size:14px;">Accéder à mon espace</a>
                    </td>
                  </tr>
                </table>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 32px; background:#f8fafc; border-top:1px solid #eef2f6; text-align:center; font-size:11px; color:#9ab0c8; line-height:1.5;">
              <p style="margin:0;">Cet email a été envoyé automatiquement, merci de ne pas y répondre.</p>
              <p style="margin:6px 0 0; color:#b5c8da;">&copy; {{year}} Paname Consulting</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>