<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alerte système - Paname Consulting</title>
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <style>
        :root { color-scheme: light; supported-color-schemes: light; }
        @media (prefers-color-scheme: dark) { body { background: #fef2f2 !important; } }
    </style>
</head>
<body style="font-family: system-ui, sans-serif; background: #fef2f2; margin: 0; padding: 24px;" bgcolor="#fef2f2">
    <div style="max-width: 640px; margin: 0 auto; background: #fff; border-radius: 12px; padding: 32px; border: 1px solid #fecaca;">
        <h1 style="color: #b91c1c; margin-top: 0;">Alerte santé du système</h1>
        <p style="color: #374151;">Horodatage : {{timestamp}}</p>
        <pre style="background: #f9fafb; padding: 16px; border-radius: 8px; overflow: auto; font-size: 13px; color: #1f2937;">{{json checks}}</pre>
        <p style="color: #6b7280; font-size: 12px;">Message automatique — Paname Consulting</p>
    </div>
</body>
</html>
