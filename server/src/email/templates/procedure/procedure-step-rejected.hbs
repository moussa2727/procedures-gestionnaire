<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Étape à traiter</title>
  <style>
    :root { color-scheme: light; }
    @media (prefers-color-scheme: dark) { body { background: #f4f5f7 !important; } }
    body { margin:0; padding:0; background-color:#f4f5f7; font-family: Arial, Helvetica, sans-serif; }
    .container { max-width:560px; margin:0 auto; padding:32px 16px; }
    .card { background:#ffffff; border-radius:8px; border:1px solid #e2e4e8; overflow:hidden; }
    .header { background:#7f1d1d; padding:24px 32px; }
    .header h1 { margin:0; color:#ffffff; font-size:18px; font-weight:600; }
    .body { padding:32px; }
    .body p { margin:0 0 16px; line-height:1.6; color:#1f2937; font-size:15px; }
    .body .info-box { background:#f9fafb; border-radius:6px; padding:16px; margin:0 0 24px; }
    .body .info-box p { margin:0 0 6px; font-size:13px; color:#374151; }
    .body .info-box .last { margin:0; }
    .body .note { font-size:13px; color:#6b7280; line-height:1.6; margin:0; }
    .body .btn { display:inline-block; background:#7f1d1d; color:#ffffff; text-decoration:none; padding:12px 32px; border-radius:6px; font-weight:600; font-size:14px; }
    .footer { padding:16px 32px; background:#f2f6fa; border-top:1px solid #dce5ef; text-align:center; font-size:11px; color:#7a9ab5; line-height:1.5; }
    .footer .copy { margin:6px 0 0; color:#9ab0c8; }
    @media (max-width:600px) {
      .header, .body, .footer { padding-left:20px; padding-right:20px; }
      .btn { display:block; text-align:center; }
    }
  </style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7; padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#ffffff; border-radius:8px; border:1px solid #e2e4e8; overflow:hidden;">
          <tr>
            <td style="background:#7f1d1d; padding:24px 32px;">
              <span style="color:#ffffff; font-size:18px; font-weight:600;">Procédures Gestionnaire</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px; font-size:15px; color:#1f2937;">Une étape de votre dossier nécessite votre attention.</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f9fafb; border-radius:6px; padding:16px; margin:0 0 24px;">
                {{#if etapeNom}}
                  <tr><td style="padding:0 0 6px; font-size:13px; color:#374151;">Étape : {{etapeNom}}</td></tr>
                {{/if}}
                {{#if numeroDossier}}
                  <tr><td style="padding:0 0 6px; font-size:13px; color:#374151;">Numéro de dossier : {{numeroDossier}}</td></tr>
                {{/if}}
                {{#if motif}}
                  <tr><td style="font-size:13px; color:#374151;">Motif : {{motif}}</td></tr>
                {{/if}}
              </table>

              {{#if etapesAnnuleesCount}}
                <p style="font-size:13px; color:#6b7280; line-height:1.6; margin:0 0 24px;">
                  Les étapes suivantes encore en attente ont également été annulées en conséquence.
                </p>
              {{/if}}

              {{#if FRONTEND_URL}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
                  <tr>
                    <td align="center">
                      <a href="{{FRONTEND_URL}}" style="display:inline-block; background:#7f1d1d; color:#ffffff; text-decoration:none; padding:12px 32px; border-radius:6px; font-weight:600; font-size:14px;">Voir mes procédures</a>
                    </td>
                  </tr>
                </table>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 32px; background:#f2f6fa; border-top:1px solid #dce5ef; text-align:center; font-size:11px; color:#7a9ab5; line-height:1.5;">
              <p style="margin:0;">Cet email a été envoyé automatiquement, merci de ne pas y répondre.</p>
              <p style="margin:6px 0 0; color:#9ab0c8;">&copy; {{year}} Paname Consulting</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>