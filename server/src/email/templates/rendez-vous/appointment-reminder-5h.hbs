<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rappel de rendez-vous H-5</title>
  <style>
    :root { color-scheme: light; }
    @media (prefers-color-scheme: dark) { body { background: #eef2f6 !important; } }
    body { margin:0; padding:0; background-color:#eef2f6; font-family: Arial, Helvetica, sans-serif; }
    .container { max-width:560px; margin:0 auto; padding:40px 16px; }
    .card { background:#ffffff; border-radius:8px; border:1px solid #d0d9e3; overflow:hidden; }
    .header { background:#dbe6f0; padding:24px 32px; border-bottom:1px solid #c0ccda; }
    .header h1 { margin:0; color:#1a3a5c; font-size:18px; font-weight:700; }
    .header span { display:block; color:#4a7a9c; font-size:13px; font-weight:400; margin-top:2px; }
    .body { padding:32px; }
    .body p { margin:0 0 16px; line-height:1.6; color:#2c4058; font-size:14px; }
    .body .info-box { background:#f2f6fa; border-radius:6px; border:1px solid #dce5ef; padding:16px; margin:0 0 24px; }
    .body .info-box .label { font-size:13px; color:#1a3a5c; font-weight:600; margin:0 0 10px; }
    .body .info-box td { padding:3px 0; font-size:13px; color:#1a2e4a; }
    .body .info-box .key { color:#3a5a7a; width:90px; vertical-align:top; }
    .body .info-box .value { font-weight:500; }
    .footer { padding:16px 32px; background:#f2f6fa; border-top:1px solid #dce5ef; text-align:center; font-size:11px; color:#7a9ab5; line-height:1.5; }
    .footer .copy { margin:6px 0 0; color:#9ab0c8; }
    @media (max-width:600px) {
      .header, .body, .footer { padding-left:20px; padding-right:20px; }
    }
  </style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef2f6; padding:40px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#ffffff; border-radius:8px; border:1px solid #d0d9e3; overflow:hidden;">
          <tr>
            <td style="background:#dbe6f0; padding:24px 32px; border-bottom:1px solid #c0ccda;">
              <span style="color:#1a3a5c; font-size:18px; font-weight:700;">Procédures Gestionnaire</span>
              <span style="display:block; color:#4a7a9c; font-size:13px; font-weight:400; margin-top:2px;">Rappel H-5</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 8px; font-size:15px; color:#1a2e4a; font-weight:600;">Bonjour,</p>
              <p style="margin:0 0 24px; font-size:14px; color:#2c4058; line-height:1.6;">
                Ce message vous rappelle que votre rendez-vous a lieu dans moins de 5 heures.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f6fa; border-radius:6px; border:1px solid #dce5ef; padding:16px; margin:0 0 24px;">
                <tr><td style="padding:0 0 10px; font-size:13px; color:#1a3a5c; font-weight:600;">Informations du rendez-vous</td></tr>
                {{#if destination}}
                  <tr><td style="padding:3px 0; font-size:13px; color:#3a5a7a; width:90px; vertical-align:top;">Destination</td><td style="padding:3px 0; font-size:13px; color:#1a2e4a; font-weight:500;">{{destination}}</td></tr>
                {{/if}}
                {{#if consultant}}
                  <tr><td style="padding:3px 0; font-size:13px; color:#3a5a7a; width:90px; vertical-align:top;">Consultant</td><td style="padding:3px 0; font-size:13px; color:#1a2e4a; font-weight:500;">{{consultant}}</td></tr>
                {{/if}}
                {{#if date}}
                  <tr><td style="padding:3px 0; font-size:13px; color:#3a5a7a; width:90px; vertical-align:top;">Date</td><td style="padding:3px 0; font-size:13px; color:#1a2e4a; font-weight:500;">{{date}}</td></tr>
                {{/if}}
                {{#if heure}}
                  <tr><td style="padding:3px 0; font-size:13px; color:#3a5a7a; width:90px; vertical-align:top;">Heure</td><td style="padding:3px 0; font-size:13px; color:#1a2e4a; font-weight:500;">{{heure}}</td></tr>
                {{/if}}
              </table>

              <p style="font-size:13px; color:#2c4058; line-height:1.6; margin:0;">
                Veuillez vous préparer et vous présenter à l'heure convenue.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 32px; background:#f2f6fa; border-top:1px solid #dce5ef; text-align:center; font-size:11px; color:#7a9ab5; line-height:1.5;">
              <p style="margin:0;">Cet email a été envoyé automatiquement, merci de ne pas y répondre.</p>
              <p style="margin:6px 0 0; color:#9ab0c8;">&copy; {{year}} Paname Consulting</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>